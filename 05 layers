<style>
/* Layers */
.pm-lb{position:fixed;inset:0;z-index:2147483000;background:color-mix(in srgb,var(--ground) 97%,transparent);
  -webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);display:flex;flex-direction:column}
.pm-lb-stage{flex:1;min-height:0;display:flex;align-items:center;justify-content:center;touch-action:pan-y;user-select:none}
.pm-lb-frame{position:relative;line-height:0}
.pm-lb-frame img{background:var(--mist);border:1px solid var(--frame);transition:opacity .3s}
.pm-lb-frame .pm-vf{--vf-inset:-14px;--vf:20px}
.pm-lb-hud{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 26px 18px;border-top:1px solid var(--line);transition:opacity .3s}
.pm-lb-info{display:flex;flex-wrap:wrap;gap:2px 22px;font-size:12.5px;color:var(--ash);min-width:0}
.pm-lb-info b{width:100%;font-family:var(--display);font-weight:400;font-size:20px;letter-spacing:.07em;color:var(--ink)}
.pm-lb-info em{font-style:normal;font-family:var(--pixel);font-size:8px;letter-spacing:.14em;color:var(--dim);margin-right:7px}
.pm-lb-ctrl{display:flex;align-items:center;gap:6px;flex:none}
.pm-ib{height:34px;min-width:34px;display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:0 10px;border:1px solid var(--line);background:var(--fill);font-size:12px;transition:border-color .2s,background .2s}
.pm-ib:hover{border-color:var(--line2);background:var(--fill2)}
.pm-ib svg{width:13px;height:13px}
.pm-count{min-width:72px;text-align:center;font-family:var(--pixel);font-size:9px;letter-spacing:.1em;color:var(--ash)}
.pm-lb.gp .pm-lb-hud,.pm-lb.gp .pm-vf{opacity:0;pointer-events:none}
.pm-lb.gp .pm-lb-hud{position:absolute;left:0;right:0;bottom:0}
@media (max-width:640px){
  .pm-lb-hud{flex-direction:column;align-items:stretch;padding:12px 14px 16px}
  .pm-lb-ctrl{justify-content:space-between}
}

.pm-cast{position:fixed;inset:0;z-index:2147483100;pointer-events:none;background:rgba(14,14,16,0);transition:background .35s;display:flex;align-items:flex-end;justify-content:center;padding-bottom:24vh}
.pm-cast.on{background:rgba(17,17,17,.42)}
.pm-cast-box{width:min(340px,80vw);opacity:0;transform:translateY(6px);transition:opacity .25s,transform .25s}
.pm-cast.on .pm-cast-box{opacity:1;transform:none}
.pm-cast-row{display:flex;justify-content:space-between;gap:12px;font-family:var(--pixel);font-size:8px;letter-spacing:.18em;margin-bottom:8px;color:#fff;text-transform:uppercase}
.pm-cast-bar{height:6px;border:1px solid rgba(255,255,255,.5);padding:1px;background:rgba(255,255,255,.06)}
.pm-cast-bar i{display:block;height:100%;width:0;background:#fff}
.pm-cast.run .pm-cast-bar i{width:100%;transition:width var(--cast,900ms) linear}
.pm-flash{position:fixed;inset:0;opacity:0;background:radial-gradient(circle at 50% 62%,rgba(255,255,255,.92) 0%,rgba(255,255,255,.6) 38%,rgba(255,255,255,0) 78%)}
.pm-cast.flash .pm-flash{animation:pm-flash .75s ease-out}
@keyframes pm-flash{0%{opacity:0}28%{opacity:1}100%{opacity:0}}

.pm-splash{position:fixed;inset:0;z-index:2147483200;background-color:var(--ground);background-image:var(--dots);background-size:26px 26px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;padding:24px;transition:opacity .9s}
.pm-splash.out{opacity:0;pointer-events:none}
.pm-splash .pm-zt>i{transform:scaleX(0);transition:transform 1.3s var(--ease)}
.pm-splash .pm-zt>i:first-child{transform-origin:right}
.pm-splash .pm-zt>i:last-child{transform-origin:left}
.pm-splash .pm-zt h2{font-size:clamp(28px,5.5vw,64px);opacity:0;letter-spacing:.42em;transition:opacity 1.2s .25s,letter-spacing 1.9s .15s var(--ease)}
.pm-splash p{opacity:0;font-family:var(--pixel);font-size:8px;letter-spacing:.24em;color:var(--ash);margin:0;transition:opacity 1.1s .9s}
.pm-splash.go .pm-zt>i{transform:scaleX(1)}
.pm-splash.go .pm-zt h2{opacity:1;letter-spacing:.14em}
.pm-splash.go p{opacity:1}

.pm-chat{position:fixed;left:16px;bottom:16px;z-index:2147482000;width:min(340px,calc(100vw - 32px));font-size:12.5px;line-height:1.55;transition:opacity .4s}
.pm-chat-tab{display:inline-flex;align-items:center;gap:8px;height:28px;padding:0 12px;border:1px solid var(--line2);background:var(--scrim);
  -webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);font-family:var(--pixel);font-size:8px;letter-spacing:.18em;text-transform:uppercase}
.pm-layer[data-lang=zh] .pm-chat-tab{font-family:var(--ui);font-size:11px;letter-spacing:.12em}
.pm-chat-tab .pm-sp{width:10px;height:10px;color:var(--line2);transition:color .25s}
.pm-chat.unread .pm-chat-tab .pm-sp{color:var(--ink);animation:pm-blink 1.8s steps(1) infinite}
.pm-chat-body{margin-top:6px;border:1px solid var(--line2);background:var(--scrim);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
.pm-chat:not(.open) .pm-chat-body{display:none}
.pm-chat-log{height:186px;overflow-y:auto;padding:10px 12px;scrollbar-width:thin;scrollbar-color:var(--line2) transparent}
.pm-chat-log p{margin:0 0 3px;overflow-wrap:anywhere}
.pm-chat-log .sys{color:var(--ash)}
.pm-chat-log .emo{color:var(--ink)}
.pm-chat-log .say{color:color-mix(in srgb,var(--ink) 80%,transparent)}
.pm-chat-log .err{color:var(--dim);font-style:italic}
.pm-chat-in{display:flex;align-items:center;gap:6px;border-top:1px solid var(--line);padding:0 12px;transition:background .2s}
.pm-chat-in span{color:var(--dim)}
.pm-chat-in input{flex:1;min-width:0;height:36px;background:none;border:0;outline:0;color:var(--ink);font:inherit;cursor:text}
.pm-chat-in input::placeholder{color:var(--dim)}
.pm-chat-in input:focus-visible{outline:none}
.pm-chat-in:focus-within{background:var(--fill)}

.pm-toast{position:fixed;top:18px;left:50%;z-index:2147483300;max-width:calc(100vw - 32px);padding:8px 16px;border:1px solid var(--line2);
  background:var(--scrim);font-size:12.5px;opacity:0;transform:translate(-50%,-8px);transition:opacity .3s,transform .3s;pointer-events:none;text-align:center}
.pm-toast.on{opacity:1;transform:translate(-50%,0)}

.pm-trail{position:fixed;inset:0;z-index:2147483400;pointer-events:none}

body.pm-gpose .pm-bar,body.pm-gpose .pm-chat,body.pm-gpose .pm-hc,body.pm-gpose .pm-vf .rd,body.pm-gpose .pm-zv-top,body.pm-gpose .pm-orn{opacity:0;pointer-events:none}

.pm.dance .pm-sp,.pm-layer.dance .pm-sp{animation:pm-spin 1s linear 3}
@keyframes pm-spin{to{transform:rotate(360deg)}}

@media (prefers-reduced-motion:reduce){
  .pm *,.pm *::before,.pm *::after,.pm-layer *,.pm-layer *::before,.pm-layer *::after{animation:none!important;transition-duration:.01ms!important}
}
</style>