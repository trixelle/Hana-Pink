<style>
/* Sections */
.pm-sec{border-top:1px solid var(--line);padding:clamp(60px,9vh,116px) clamp(20px,4vw,58px)}
.pm-in{max-width:1180px;margin:0 auto}
.pm-head{display:flex;align-items:flex-end;gap:16px}
.pm-head .pm-idx{padding-bottom:12px}
.pm-head h2,.pm-head>i,.pm-head .pm-sp{margin-bottom:0}
.pm-head>i{margin-bottom:14px}
.pm-head .pm-sp{margin-bottom:12px}
.pm-head h2{font-family:var(--display);font-weight:300;font-size:clamp(32px,4vw,50px);letter-spacing:.1em;line-height:1.1;white-space:nowrap}
.pm-head .pm-sp{color:var(--line2);flex:none}
.pm-head>i{flex:1;height:1px;background:linear-gradient(90deg,var(--line2),transparent)}
.pm-lede{margin:14px 0 40px;color:var(--ash);max-width:56ch}
.pm-sp{width:14px;height:14px;flex:none;overflow:visible}
.pm-sp path{fill:currentColor}

/* Featured banner */
.pm-feat{position:relative;display:grid;align-items:end;width:100%;min-height:clamp(190px,26vh,280px);margin-bottom:26px;overflow:hidden;border:1px solid var(--frame);background:var(--mist)}
.pm-feat img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .6s,transform 1.2s var(--ease)}
.pm-feat img.on{opacity:1}
.pm-feat:hover img.on{transform:scale(1.03)}
.pm-feat::after{content:"";position:absolute;inset:0;background:linear-gradient(115deg,var(--paper),color-mix(in srgb,var(--paper) 55%,transparent) 58%,transparent)}
.pm-feat-c{position:relative;z-index:1;padding:clamp(20px,3vw,34px)}
.pm-feat-c small{display:block;font-family:var(--pixel);font-size:8px;letter-spacing:.2em;color:var(--ash)}
.pm-feat-c b{display:block;font-family:var(--display);font-weight:300;font-size:clamp(28px,3.4vw,42px);letter-spacing:.1em;line-height:1.15;margin-top:6px}
.pm-feat-c span{display:inline-flex;align-items:center;gap:8px;margin-top:8px;font-size:12px;color:var(--ash)}
.pm-feat .pm-vf{--vf-inset:12px;--vf:18px;z-index:1}

/* Teleport list */
.pm-tp{display:grid;grid-template-columns:220px minmax(0,1fr) minmax(280px,34%);border:1px solid var(--frame);background:var(--paper);min-height:540px}
.pm-regions{border-right:1px solid var(--line);padding:12px 0;display:flex;flex-direction:column}
.pm-region{display:flex;justify-content:space-between;align-items:baseline;gap:10px;padding:13px 20px;color:var(--ash);border-left:1px solid transparent;transition:color .2s,background .25s,border-color .2s}
.pm-region .l{display:block}
.pm-region .l small{display:block;font-size:11px;color:var(--dim)}
.pm-region .c{font-family:var(--pixel);font-size:9px;color:var(--dim)}
.pm-region:hover{color:var(--ink);background:var(--fill)}
.pm-region[aria-selected=true]{color:var(--ink);border-left-color:currentColor;background:var(--fill2)}
.pm-places{border-right:1px solid var(--line);overflow:auto;max-height:640px}
.pm-place{display:grid;grid-template-columns:20px minmax(0,1fr) auto;align-items:center;gap:16px;width:100%;min-height:74px;padding:12px 22px;border-bottom:1px solid var(--line);transition:background .25s}
.pm-place .pm-sp{color:var(--line2);transition:color .3s,transform .5s var(--ease)}
.pm-place.hot{background:var(--fill2)}
.pm-place.hot .pm-sp{color:var(--ink);transform:rotate(90deg)}
.pm-place .th{display:none;width:56px;height:56px;object-fit:cover;background:var(--mist)}
.pm-place b{display:block;font-weight:500;font-size:16px;letter-spacing:.05em}
.pm-place small{display:block;color:var(--dim);font-size:12px}
.pm-place .ct{font-family:var(--pixel);font-size:8px;letter-spacing:.14em;color:var(--ash);white-space:nowrap;text-align:right}
.pm-place .ct em{font-style:normal;font-size:13px;color:var(--ink);margin-right:6px}
.pm-preview{position:relative;overflow:hidden;background:var(--mist)}
.pm-preview img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .6s}
.pm-preview img.on{opacity:1}
.pm-preview::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 38%,var(--paper))}
.pm-preview .pm-vf{--vf-inset:14px;--vf:18px;z-index:1}
.pm-pv-cap{position:absolute;left:26px;right:26px;bottom:24px;z-index:2}
.pm-pv-cap small{display:block;font-family:var(--pixel);font-size:8px;letter-spacing:.2em;color:var(--ash)}
.pm-pv-cap b{display:block;font-family:var(--display);font-weight:300;font-size:30px;line-height:1.2;letter-spacing:.08em;margin-top:4px}
.pm-pv-cap span{display:inline-flex;align-items:center;gap:8px;margin-top:6px;font-size:12px;color:var(--ash)}
@media (max-width:980px){
  .pm-tp{grid-template-columns:1fr;min-height:0}
  .pm-regions{flex-direction:row;border-right:0;border-bottom:1px solid var(--line);padding:0;overflow-x:auto;scrollbar-width:none}
  .pm-region{border-left:0;border-bottom:1px solid transparent;padding:12px 16px;white-space:nowrap}
  .pm-region .c{display:none}
  .pm-region[aria-selected=true]{border-bottom-color:currentColor}
  .pm-places{border-right:0;max-height:none}
  .pm-place{grid-template-columns:56px minmax(0,1fr) auto;padding:10px 14px;gap:14px}
  .pm-place .pm-sp{display:none}
  .pm-place .th{display:block}
  .pm-preview{display:none}
}

/* Zone (category) view */
.pm-zv{min-height:100vh;padding:0 clamp(12px,3vw,40px) 90px}
.pm-zv-top{position:sticky;top:var(--barh);z-index:6;display:flex;align-items:center;gap:14px;padding:12px 0;background:var(--scrim);
  -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);transition:opacity .4s}
.pm-return{flex:none;display:inline-flex;align-items:center;gap:8px;height:32px;padding:0 14px;border:1px solid var(--line2);
  font-family:var(--pixel);font-size:8px;letter-spacing:.18em;text-transform:uppercase;transition:background .25s,color .25s}
.pm-return:hover{background:var(--ink);color:var(--paper)}
.pm[data-lang=zh] .pm-return{font-family:var(--ui);font-size:12px;letter-spacing:.1em}
.pm-tabs{display:flex;gap:2px;overflow-x:auto;scrollbar-width:none;min-width:0}
.pm-tabs::-webkit-scrollbar,.pm-nav::-webkit-scrollbar,.pm-regions::-webkit-scrollbar{display:none}
.pm-tabs button{padding:6px 12px;font-size:12.5px;color:var(--ash);white-space:nowrap;border:1px solid transparent;transition:color .2s,border-color .2s}
.pm-tabs button:hover{color:var(--ink)}
.pm-tabs button[aria-current=true]{color:var(--ink);border-color:var(--line2)}
.pm-zv-head{padding:clamp(40px,7vh,72px) 0 clamp(26px,4vh,42px)}
.pm-zv-head .pm-zt h1{font-size:clamp(28px,4.6vw,58px)}
.pm-zv-meta{margin-top:12px;text-align:center;font-family:var(--pixel);font-size:8px;letter-spacing:.2em;color:var(--ash)}
.pm[data-lang=zh] .pm-zv-meta{font-family:var(--ui);font-size:12px;letter-spacing:.14em}
.pm-loadline{height:1px;margin:0 auto 24px;width:min(320px,60%);background:linear-gradient(90deg,transparent,var(--line2),transparent);background-size:50% 100%;background-repeat:no-repeat;animation:pm-scan 1.2s linear infinite}
@keyframes pm-scan{from{background-position:-100% 0}to{background-position:200% 0}}
.pm-grid{display:flex;flex-wrap:wrap;gap:8px}
.pm-grid::after{content:"";flex-grow:999999}
@media (max-width:560px){.pm-grid{gap:5px}}
.pm-tile{position:relative;display:block;overflow:hidden;background:var(--mist)}
.pm-tile>i{display:block}
.pm-tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .6s,transform .8s var(--ease)}
.pm-tile img.ld{opacity:1}
.pm-tile::after{content:"";position:absolute;inset:0;border:1px solid transparent;transition:inset .35s var(--ease),border-color .35s}
.pm-tile:hover img{transform:scale(1.04)}
.pm-tile:hover::after,.pm-tile:focus-visible::after{inset:7px;border-color:rgba(255,255,255,.9)}
.pm-tile .fn{position:absolute;top:9px;left:11px;font-family:var(--pixel);font-size:8px;letter-spacing:.1em;color:#fff;opacity:0;transition:opacity .25s;text-shadow:0 1px 5px rgba(0,0,0,.85)}
.pm-tile .tt{position:absolute;left:12px;right:12px;bottom:11px;font-size:11.5px;color:#fff;opacity:0;transform:translateY(4px);
  transition:opacity .3s,transform .3s;text-shadow:0 1px 8px rgba(0,0,0,.6);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pm-tile:hover .tt{opacity:1;transform:none}
.pm-tile:hover .fn{opacity:.95}
.pm-note{padding:56px 0 24px;text-align:center;font-family:var(--pixel);font-size:8px;letter-spacing:.2em;color:var(--dim)}
.pm[data-lang=zh] .pm-note{font-family:var(--ui);font-size:13px;letter-spacing:.1em}
.pm-note .pm-return{margin-top:18px}
.pm-sentinel{height:1px}

</style>