<style>
/* Adventure plate */
.pm-plate{display:grid;grid-template-columns:minmax(260px,400px) minmax(0,1fr);border:1px solid var(--frame);background:var(--paper)}
.pm-pcell{padding:clamp(24px,3vw,42px);border-right:1px solid var(--line);display:flex;align-items:flex-start}
.pm-portrait{position:relative;width:100%;padding:11px;background:#fff;border:1px solid var(--frame);box-shadow:0 12px 30px rgba(0,0,0,.14);transition:transform .5s var(--ease)}
.pm-portrait img{width:100%;aspect-ratio:3/4;object-fit:cover;background:var(--mist)}
.pm-portrait figcaption{display:flex;justify-content:space-between;gap:10px;margin-top:10px;font-family:var(--pixel);font-size:7.5px;letter-spacing:.16em;color:var(--dim)}
.pm-portrait .pm-vf{--vf-inset:-11px;--vf:18px}
.pm-portrait::after{content:"";position:absolute;inset:11px;background:radial-gradient(circle at var(--mx,50%) var(--my,30%),rgba(255,255,255,.45),transparent 52%);mix-blend-mode:soft-light;opacity:0;transition:opacity .35s;pointer-events:none}
.pm-portrait:hover::after{opacity:1}
.pm-pcell{flex-direction:column;gap:18px}
.pm-look{max-width:36ch;font-family:var(--display);font-style:italic;font-size:16px;line-height:1.6;color:var(--ash)}
.pm[data-lang=zh] .pm-look{font-style:normal;font-size:14px;letter-spacing:.06em}
.pm-pbody{padding:clamp(24px,3.6vw,52px)}
.pm-ptitle{font-family:var(--pixel);font-size:9px;letter-spacing:.2em;color:var(--ash);text-transform:uppercase}
.pm[data-lang=zh] .pm-ptitle{font-family:var(--ui);font-size:12px;letter-spacing:.18em}
.pm-pname{font-family:var(--display);font-weight:300;font-size:clamp(38px,4.6vw,58px);letter-spacing:.08em;line-height:1.05;margin-top:8px}
.pm-stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin:28px 0 8px;border-top:1px solid var(--line)}
.pm-stats>div{padding:13px 16px 13px 0;border-bottom:1px solid var(--line)}
.pm-stats dd{max-width:30ch}
.pm-stats dt{font-family:var(--pixel);font-size:7.5px;letter-spacing:.18em;color:var(--dim)}
.pm[data-lang=zh] .pm-stats dt{font-family:var(--ui);font-size:11px;letter-spacing:.12em}
.pm-stats dd{font-size:15.5px;margin-top:3px}
.pm-pbody h4{font-family:var(--pixel);font-size:8px;letter-spacing:.2em;color:var(--ash);margin:30px 0 12px;text-transform:uppercase}
.pm[data-lang=zh] .pm-pbody h4{font-family:var(--ui);font-size:12px;letter-spacing:.16em}
.pm-bio p{max-width:62ch;color:color-mix(in srgb,var(--ink) 86%,transparent)}
.pm-bio p+p{margin-top:12px}
.pm-likes{display:flex;flex-wrap:wrap;gap:8px}
.pm-likes{margin-top:22px}
.pm-likes li{border:1px solid var(--line);background:var(--fill);padding:5px 13px;font-size:12.5px;color:var(--ash)}
.pm-notes{display:grid;gap:0;border-top:1px solid var(--line)}
.pm-notes>div{display:grid;grid-template-columns:minmax(96px,20%) minmax(0,1fr);gap:16px;padding:12px 0;border-bottom:1px solid var(--line)}
.pm-notes dt{font-family:var(--pixel);font-size:7.5px;letter-spacing:.18em;color:var(--dim);padding-top:4px}
.pm[data-lang=zh] .pm-notes dt{font-family:var(--ui);font-size:11px;letter-spacing:.12em}
.pm-notes dd{font-size:14.5px;color:var(--ash)}
.pm-secret{display:block;width:100%;margin-top:26px;padding:14px 16px;border:1px dashed var(--line2);background:var(--fill);text-align:left}
.pm-secret .sk{display:block;font-family:var(--pixel);font-size:7.5px;letter-spacing:.2em;color:var(--dim)}
.pm[data-lang=zh] .pm-secret .sk{font-family:var(--ui);font-size:11px;letter-spacing:.14em}
.pm-secret .sv{display:block;margin-top:6px;font-size:14.5px;color:var(--ink);filter:blur(5px);opacity:.75;transition:filter .5s var(--ease),opacity .5s;user-select:none}
.pm-secret .sh{display:block;margin-top:6px;font-family:var(--pixel);font-size:7.5px;letter-spacing:.18em;color:var(--dim);transition:opacity .3s}
.pm[data-lang=zh] .pm-secret .sh{font-family:var(--ui);font-size:11px}
.pm-secret.open .sv{filter:none;opacity:1;user-select:auto}
.pm-secret.open .sh{opacity:0}
.pm-secret:hover{border-color:var(--ash)}
@media (max-width:820px){
  .pm-plate{grid-template-columns:1fr}
  .pm-pcell{border-right:0;border-bottom:1px solid var(--line);justify-content:center}
  .pm-portrait{max-width:330px}
  .pm-stats{grid-template-columns:1fr}
}

/* Linkshell */
.pm-ls{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid var(--frame);border-left:1px solid var(--frame)}
.pm-ls a{display:grid;grid-template-columns:40px minmax(0,1fr) auto;align-items:center;gap:12px;padding:21px 22px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--fill);transition:background .25s,color .25s}
.pm-ls .ch{font-family:var(--pixel);font-size:8px;color:var(--dim);transition:color .2s}
.pm-ls b{display:block;font-weight:500;font-size:17px;letter-spacing:.04em}
.pm-ls small{display:block;color:var(--ash);font-size:12.5px;transition:color .2s;overflow:hidden;text-overflow:ellipsis}
.pm-ls svg{width:13px;height:13px}
.pm-ls a:hover{background:var(--ink);color:var(--paper)}
.pm-ls a:hover .ch,.pm-ls a:hover small{color:color-mix(in srgb,var(--paper) 60%,var(--ink))}
@media (max-width:700px){.pm-ls{grid-template-columns:1fr}.pm-ls a{padding:17px 14px}}

.pm-foot{border-top:1px solid var(--line);padding:26px clamp(20px,4vw,58px) 92px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px 24px;
  font-family:var(--pixel);font-size:7.5px;line-height:2.2;letter-spacing:.16em;color:var(--dim)}

</style>