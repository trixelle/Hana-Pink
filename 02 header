<style>
/* Header */
.pm-bar{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:24px;min-height:64px;padding:0 clamp(20px,3vw,46px);
  background:var(--scrim);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);transition:opacity .4s}
.pm-brand{display:flex;flex-direction:column;align-items:flex-start;gap:3px;line-height:1;white-space:nowrap}
.pm-brand .n{font-family:var(--display);font-size:25px;font-weight:400;letter-spacing:.12em}
.pm-brand .w{font-family:var(--pixel);font-size:8px;letter-spacing:.22em;color:var(--ash)}
.pm-nav{display:flex;gap:2px;margin-left:auto}
.pm-nav button{position:relative;padding:8px 12px;font-size:13.5px;letter-spacing:.05em;color:var(--ash);transition:color .2s;white-space:nowrap}
.pm-nav button::after{content:"";position:absolute;left:12px;right:12px;bottom:3px;height:1px;background:currentColor;transform:scaleX(0);transform-origin:left;transition:transform .35s var(--ease)}
.pm-nav button:hover,.pm-nav button[aria-current=true]{color:var(--ink)}
.pm-nav button:hover::after,.pm-nav button[aria-current=true]::after{transform:scaleX(1)}
.pm-tools{display:flex;align-items:center;gap:6px}
.pm-chip{height:30px;display:inline-flex;align-items:center;gap:7px;padding:0 10px;border:1px solid var(--line);background:var(--fill);font-size:12px;transition:border-color .2s,background .2s}
.pm-chip:hover{border-color:var(--line2);background:var(--fill2)}
.pm-chip small{font-family:var(--pixel);font-size:8px;letter-spacing:.1em;color:var(--dim)}
.pm-clock .t{font-family:var(--pixel);font-size:11px;letter-spacing:.04em;min-width:4.4em}
.pm-lang span{color:var(--dim);transition:color .2s}
.pm-lang span.on{color:var(--ink)}
.pm-lang i{width:1px;height:11px;background:var(--line2)}
.pm-eq{display:flex;gap:2px;align-items:flex-end;height:11px}
.pm-eq i{width:2px;height:3px;background:currentColor}
.pm-sound[aria-pressed=true] .pm-eq i{animation:pm-eq 1.3s ease-in-out infinite}
.pm-sound[aria-pressed=true] .pm-eq i:nth-child(2){animation-delay:-.45s}
.pm-sound[aria-pressed=true] .pm-eq i:nth-child(3){animation-delay:-.9s}
@keyframes pm-eq{0%,100%{height:3px}50%{height:11px}}
@media (max-width:820px){
  .pm-bar{flex-wrap:wrap;gap:8px 12px;padding-top:12px;padding-bottom:4px}
  .pm-nav{order:3;width:calc(100% + 24px);margin:0 -12px;overflow-x:auto;scrollbar-width:none}
  .pm-tools{margin-left:auto}
  .pm-brand .n{font-size:21px}
  .pm-clock small{display:none}
}

/* Viewfinder motif */
.pm-vf{position:absolute;inset:var(--vf-inset,16px);pointer-events:none;transition:opacity .4s;color:currentColor}
.pm-vf>i{position:absolute;width:var(--vf,24px);height:var(--vf,24px);border:0 solid currentColor;opacity:.6}
.pm-vf>i:nth-child(1){top:0;left:0;border-top-width:1px;border-left-width:1px}
.pm-vf>i:nth-child(2){top:0;right:0;border-top-width:1px;border-right-width:1px}
.pm-vf>i:nth-child(3){bottom:0;left:0;border-bottom-width:1px;border-left-width:1px}
.pm-vf>i:nth-child(4){bottom:0;right:0;border-bottom-width:1px;border-right-width:1px}
.pm-vf.on-photo{color:#fff;filter:drop-shadow(0 1px 2px rgba(0,0,0,.5))}
.pm-vf .rd{position:absolute;font-family:var(--pixel);font-size:8px;letter-spacing:.14em;opacity:.9;transition:opacity .4s}
.pm-vf .tl{top:-2px;left:34px;display:flex;align-items:center;gap:7px}
.pm-vf .tl b{width:5px;height:5px;background:currentColor;transform:rotate(45deg);animation:pm-blink 2.6s steps(1) infinite}
.pm-vf .tr{top:-2px;right:34px}
.pm-vf .br{bottom:-4px;right:34px}
@keyframes pm-blink{50%{opacity:.2}}

/* display title with rules */
.pm-zt{display:flex;align-items:center;justify-content:center;gap:clamp(14px,3vw,30px);width:min(100%,1080px);margin:0 auto}
.pm-zt>i{flex:1;min-width:20px;height:1px;background:linear-gradient(90deg,transparent,currentColor)}
.pm-zt>i:last-child{background:linear-gradient(270deg,transparent,currentColor)}
.pm-zt h1,.pm-zt h2{font-family:var(--display);font-weight:300;font-size:clamp(30px,5.4vw,70px);line-height:1.1;letter-spacing:.14em;text-align:center}
.pm[data-lang=zh] .pm-zt h1,.pm[data-lang=zh] .pm-zt h2{letter-spacing:.2em}

/* the viewfinder */
.pm-hero{padding:clamp(14px,2vw,30px) clamp(14px,2vw,30px) 0}
.pm-view{position:relative;overflow:hidden;min-height:min(78vh,780px);display:flex;align-items:flex-end;border:1px solid var(--frame);background:#0c0c0e;isolation:isolate}
.pm-view .pm-hero-pic{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.07);transition:transform 3.4s var(--ease),opacity .45s}
.pm-hero.in .pm-view .pm-hero-pic{transform:scale(1)}
.pm-view-dim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(9,9,11,.6) 0%,rgba(9,9,11,.12) 34%,rgba(9,9,11,.5) 66%,rgba(9,9,11,.88) 100%)}
.pm-view::after{content:"";position:absolute;inset:0;background:#fff;opacity:0;pointer-events:none;z-index:6}
.pm-view.snap::after{animation:pm-snap .5s ease-out}
@keyframes pm-snap{0%{opacity:0}12%{opacity:.85}100%{opacity:0}}

/* framing guides */
.pm-thirds{position:absolute;inset:0;pointer-events:none}
.pm-thirds i{position:absolute;background:rgba(255,255,255,.14)}
.pm-thirds i:nth-child(1){left:33.33%;top:0;bottom:0;width:1px}
.pm-thirds i:nth-child(2){left:66.66%;top:0;bottom:0;width:1px}
.pm-thirds i:nth-child(3){top:33.33%;left:0;right:0;height:1px}
.pm-thirds i:nth-child(4){top:66.66%;left:0;right:0;height:1px}
.pm-reticle{position:absolute;left:50%;top:50%;width:26px;height:26px;transform:translate(-50%,-50%);pointer-events:none;opacity:.75}
.pm-reticle span{position:absolute;background:#fff}
.pm-reticle span:nth-child(1){left:50%;top:0;bottom:0;width:1px;transform:translateX(-50%)}
.pm-reticle span:nth-child(2){top:50%;left:0;right:0;height:1px;transform:translateY(-50%)}
.pm-focus{position:absolute;left:54%;top:17%;width:32%;height:42%;pointer-events:none}
.pm-focus i{position:absolute;width:20px;height:20px;border:0 solid rgba(255,255,255,.9)}
.pm-focus i:nth-child(1){top:0;left:0;border-top-width:1px;border-left-width:1px}
.pm-focus i:nth-child(2){top:0;right:0;border-top-width:1px;border-right-width:1px}
.pm-focus i:nth-child(3){bottom:0;left:0;border-bottom-width:1px;border-left-width:1px}
.pm-focus i:nth-child(4){bottom:0;right:0;border-bottom-width:1px;border-right-width:1px}
.pm-hero.in .pm-focus,.pm-view.snap .pm-focus{animation:pm-lock 1.1s var(--ease)}
@keyframes pm-lock{0%{transform:scale(1.28);opacity:0}45%{opacity:1}70%{transform:scale(.98)}100%{transform:scale(1);opacity:1}}

/* HUD */
.pm-hud{position:absolute;inset:0;pointer-events:none;font-family:var(--pixel);font-size:8.5px;letter-spacing:.16em;color:rgba(255,255,255,.86);text-shadow:0 1px 3px rgba(0,0,0,.6)}
.pm-layer[data-lang=zh] .pm-hud,.pm[data-lang=zh] .pm-hud{font-family:var(--pixel)}
.pm-hud>div{position:absolute;display:flex;align-items:center;gap:10px}
.pm-hud .tl{top:clamp(14px,2vw,22px);left:clamp(14px,2vw,24px)}
.pm-hud .tr{top:clamp(14px,2vw,22px);right:clamp(14px,2vw,24px)}
.pm-hud .br{bottom:clamp(86px,9vw,108px);right:clamp(14px,2vw,24px);flex-direction:column;align-items:flex-end;gap:6px;text-align:right}
.pm-hud .rec{width:7px;height:7px;border-radius:50%;background:#fff;box-shadow:0 0 8px rgba(255,255,255,.8);animation:pm-rec 1.8s steps(1) infinite}
@keyframes pm-rec{50%{opacity:.15}}
.pm-hud .tc{font-variant-numeric:tabular-nums}
.pm-hud .sc{position:absolute;left:clamp(14px,2vw,24px);top:50%;transform:translateY(-50%);width:9px;height:150px;
  background:repeating-linear-gradient(180deg,rgba(255,255,255,.55) 0 1px,transparent 1px 15px);opacity:.7}
.pm-hud .sc::after{content:"";position:absolute;left:-4px;top:38%;width:17px;height:1px;background:#fff}
@media (max-width:640px){.pm-hud .sc{display:none}}

/* name block */
.pm-hc{position:relative;z-index:5;padding:clamp(22px,4vw,54px) clamp(18px,4vw,56px) clamp(22px,3vw,44px);max-width:min(100%,780px);transition:opacity .4s}
.pm-hc .pm-eyebrow{color:rgba(255,255,255,.72)}
.pm-title{font-family:var(--display);font-weight:300;font-size:clamp(50px,8vw,112px);line-height:.95;letter-spacing:.04em;color:#fff;margin:6px 0 0}
.pm-rule{display:block;width:72px;height:1px;background:rgba(255,255,255,.5);margin:18px 0}
.pm-sub{font-size:clamp(14px,1.3vw,17px);color:rgba(255,255,255,.78);max-width:34ch}
.pm-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px;pointer-events:auto}
.pm-btn{display:inline-flex;align-items:center;gap:10px;height:46px;padding:0 24px;border:1px solid rgba(255,255,255,.55);background:rgba(255,255,255,.06);color:#fff;
  font-size:11px;letter-spacing:.22em;text-transform:uppercase;transition:background .28s,color .28s,border-color .28s}
.pm-btn:hover{background:#fff;color:#111;border-color:#fff}
.pm[data-lang=zh] .pm-btn{font-size:13px;letter-spacing:.16em}
.pm-sec .pm-btn{border-color:var(--line2);background:var(--fill);color:inherit}
.pm-sec .pm-btn:hover{background:var(--ink);color:var(--paper)}

/* shutter */
.pm-shutter{position:absolute;right:clamp(16px,3vw,34px);bottom:clamp(16px,3vw,34px);z-index:7;width:62px;height:62px;border-radius:50%;
  border:1px solid rgba(255,255,255,.7);display:grid;place-items:center;background:rgba(10,10,12,.35);
  -webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);transition:transform .2s var(--ease),background .25s}
.pm-shutter span{width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.9);transition:transform .15s var(--ease),background .25s}
.pm-shutter:hover span{transform:scale(1.06)}
.pm-shutter:active span{transform:scale(.88)}
.pm-shutter::after{content:attr(data-hint);position:absolute;right:calc(100% + 12px);top:50%;transform:translateY(-50%);
  font-family:var(--pixel);font-size:8px;letter-spacing:.18em;color:rgba(255,255,255,.75);white-space:nowrap;opacity:0;transition:opacity .25s}
.pm-shutter:hover::after{opacity:1}
@media (max-width:640px){
  .pm-view{min-height:min(74vh,620px)}
  .pm-hud .br{display:none}
  .pm-hc{padding-bottom:86px}
  .pm-shutter{right:14px;bottom:14px}
  .pm-focus{left:50%;top:14%;width:36%;height:34%}
  .pm-shutter{width:50px;height:50px}
  .pm-shutter span{width:32px;height:32px}
  .pm-hud{font-size:7.5px}
}

/* facts strip */
.pm-facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-bottom:1px solid var(--line)}
.pm-facts>div{padding:26px 20px;border-right:1px solid var(--line);text-align:center}
.pm-facts>div:last-child{border-right:0}
.pm-facts dt{font-family:var(--pixel);font-size:8px;letter-spacing:.2em;color:var(--dim)}
.pm-facts dd{font-family:var(--display);font-size:clamp(26px,3vw,38px);font-weight:300;letter-spacing:.06em;margin-top:6px}
@media (max-width:620px){.pm-facts>div{padding:16px 8px}.pm-facts dd{font-size:24px}}

</style>